# Currency used to format prices (ISO 4217 code). Prices come from the backend as plain numbers.
VITE_CURRENCY=INR
# Locale used for number and date formatting.
VITE_LOCALE=en-IN

# "Sign in with Google": the OAuth client ID from Google Cloud Console (it is public, not a secret).
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=