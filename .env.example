# Copy this file to .env and fill in real values. The real .env must never be committed.
DB_ROOT_PASSWORD=change_me
DB_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_value_of_at_least_32_characters
WEBHOOK_SECRET=change_me_to_another_long_random_value
# Optional: Google sign-in. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
# Time zone of the containers (keep it equal to your browser's zone).
TZ=Asia/Kolkata
